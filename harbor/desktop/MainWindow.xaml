                  <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="候选默认出口" Style="{StaticResource Hint}" Margin="0,0,0,6"/><ComboBox x:Name="RehearsalPolicy" SelectionChanged="PreviewConditionsChanged"/></StackPanel>
                  <Button Grid.Column="2" Content="比较路径" Click="CompareExit" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                </Grid><TextBox x:Name="RehearsalTargets" Text="example.com:443 tcp" TextChanged="PreviewConditionsChanged" AcceptsReturn="True" Height="80" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="每行：域名或 IP:端口 tcp/udp。离线比较修改前后路径，不发送请求，不影响现有连接；节点健康按未测量处理。" Style="{StaticResource Hint}" Margin="0,10,0,16" />
                <DataGrid x:Name="RehearsalGrid" Height="180">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*" />
                    <DataGridTextColumn Header="当前出口" Binding="{Binding Before}" Width="135" />
                    <DataGridTextColumn Header="候选出口" Binding="{Binding After}" Width="135" />
                    <DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="110" />
                  </DataGrid.Columns>
                  <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                      <Setter Property="ToolTip" Value="{Binding Reason}" />
                    </Style>
                  </DataGrid.RowStyle>
                </DataGrid>
                <TextBlock x:Name="RehearsalSummary" Text="尚未执行预演。" Style="{StaticResource Hint}" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <DockPanel Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="↑" Click="MoveRuleUp" IsEnabled="{Binding SelectedItem, ElementName=RuleGrid, Converter={StaticResource HasSelection}}" Margin="0,0,6,0" />
                <Button Content="↓" Click="MoveRuleDown" IsEnabled="{Binding SelectedItem, ElementName=RuleGrid, Converter={StaticResource HasSelection}}" Margin="0,0,6,0" />
                <Button Content="编辑" Click="EditRule" IsEnabled="{Binding SelectedItem, ElementName=RuleGrid, Converter={StaticResource HasSelection}}" Margin="0,0,6,0"/><Button Content="启用 / 停用" Click="ToggleRule" IsEnabled="{Binding SelectedItem, ElementName=RuleGrid, Converter={StaticResource HasSelection}}" Margin="0,0,6,0"/><Button Content="移除" Click="RemoveRule" IsEnabled="{Binding SelectedItem, ElementName=RuleGrid, Converter={StaticResource HasSelection}}" Margin="0,0,6,0" />
                <Button Content="添加规则" Click="AddRule" />
              </StackPanel>
              <TextBlock Text="匹配规则" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="RuleModeHint" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,16">
              <DataGrid x:Name="RuleGrid" Height="220" MouseDoubleClick="EditRule">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="140" />
                  <DataGridTextColumn Header="匹配值" Binding="{Binding Value}" Width="*" />
                  <DataGridTextColumn Header="策略" Binding="{Binding Policy}" Width="150" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <DockPanel Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="编辑" Click="EditGroup" IsEnabled="{Binding SelectedItem, ElementName=GroupGrid, Converter={StaticResource HasSelection}}" Margin="0,0,6,0" />
                <Button Content="移除" Click="RemoveGroup" IsEnabled="{Binding SelectedItem, ElementName=GroupGrid, Converter={StaticResource HasSelection}}" Margin="0,0,6,0" />
                <Button Content="添加策略组" Click="AddGroup" />
              </StackPanel>
              <TextBlock Text="策略组" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,16">
              <DataGrid x:Name="GroupGrid" Height="170" MouseDoubleClick="EditGroup">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="选择方式" Binding="{Binding Kind}" Width="160" />
                  <DataGridTextColumn Header="成员" Binding="{Binding Members}" Width="160" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="编辑完整配置" Click="EditProfile" />
                  <TextBlock Text="高级配置" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="自动策略组采用连续失败判断和切换冷却时间。需要直连备用时，必须显式加入 DIRECT。" Style="{StaticResource Hint}" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="DnsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <DockPanel><Button Content="隐私设置" Tag="Privacy" Click="Navigate" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="DNS" Style="{StaticResource Heading}" /></DockPanel>
            <TextBlock Text="使用真实 IP 解析，停止代理后无需等待虚拟 IP 缓存失效。" Style="{StaticResource Hint}" Margin="0,0,0,22" />
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="选择 DNS 服务" Style="{StaticResource Section}"/>
                <DockPanel><Button Content="应用服务" Click="ApplyDnsProvider" DockPanel.Dock="Right" Margin="12,0,0,0"/><ComboBox x:Name="DnsProvider"><sys:String>自动 · 加密解析</sys:String><sys:String>阿里 DNS · 加密解析</sys:String><sys:String>Cloudflare · 加密解析</sys:String><sys:String>AdGuard · 广告与追踪过滤</sys:String><sys:String>自定义</sys:String></ComboBox></DockPanel>
                <TextBlock Text="自动模式优先使用阿里 DNS，连接失败时尝试 Cloudflare，均使用 HTTPS 加密。AdGuard 提供服务端广告过滤。所选服务可以看到查询；仅覆盖由 Harbor 解析的请求。" Style="{StaticResource Hint}" Margin="0,12,0,20"/>
                <Expander x:Name="DnsAdvanced" Header="自定义服务器" Margin="0,0,0,18"><StackPanel Margin="0,14,0,0">
                <CheckBox x:Name="DnsEncrypted" Content="使用加密 DNS（DoH / DoT）" Margin="0,0,0,14" />
                <TextBox x:Name="DnsTlsServers" AcceptsReturn="True" Height="86" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="每行填写 IP:端口 和 TLS 服务器名；DoH 再加 HTTPS 路径，例如 /dns-query。始终验证证书，失败不回退明文 DNS。" Style="{StaticResource Hint}" Margin="0,10,0,22" />
                <TextBlock Text="普通 DNS（仅在关闭加密 DNS 时使用）" Style="{StaticResource Section}" />
                <TextBox x:Name="DnsServers" ToolTip="逗号分隔的 IP:端口，例如 1.1.1.1:53" />
                <TextBlock Text="IP:端口，使用逗号分隔。不会修改物理网卡的 DNS。" Style="{StaticResource Hint}" Margin="0,10,0,18" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="保存 DNS" Click="SaveDns" Style="{StaticResource Primary}" Margin="0,0,10,0" />
                  <Button x:Name="ClearDnsButton" Content="清空缓存" Click="ClearDns" />
                </StackPanel>
                </StackPanel></Expander><Border Height="1" Background="{StaticResource Line}" Margin="0,6,0,24" />
                <TextBlock x:Name="DnsStats" Text="缓存 0 条 · 命中 0 次 · 上游请求 0 次 · 合并 0 次" FontSize="14" TextWrapping="Wrap" />
                <TextBlock x:Name="DnsAddress" Text="本地解析器：127.0.0.1:5357" Style="{StaticResource Hint}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="诊断" Style="{StaticResource Heading}" />
            <TextBlock Text="只记录连接元数据和运行事件，不采集请求正文。" Style="{StaticResource Hint}" Margin="0,0,0,22" />
            <TextBlock x:Name="DialingStats" Text="连接后显示首连调度统计。" Style="{StaticResource Hint}" Margin="0,0,0,14" />
          </StackPanel>
          <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="导出诊断" Click="ExportDiagnostics" Margin="0,0,8,0" />
              <Button Content="恢复系统网络" Click="RecoverNetwork" />
            </StackPanel>
            <TextBlock x:Name="DiagnosticSummary" Text="等待引擎启动。" VerticalAlignment="Center" Style="{StaticResource Hint}" />
          </DockPanel>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
            <Grid>
              <DataGrid x:Name="EventGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="95" />
                  <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="75" />
                  <DataGridTextColumn Header="事件" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,42,20,0" IsHitTestVisible="False">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=EventGrid}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="暂无运行事件" FontSize="14" Foreground="#53616C" TextAlignment="Center" />
                <TextBlock Text="引擎启动和网络恢复记录会显示在这里。" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource Heading}" />
            <TextBlock Text="配置保存在当前 Windows 用户的加密存储中。" Style="{StaticResource Hint}" Margin="0,0,0,22" />
            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
              <DockPanel>
                <Button x:Name="WorkspaceHistoryButton" Content="查看与恢复" Click="ShowWorkspaceHistory" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0" />
                <StackPanel>
                  <TextBlock Text="配置历史" Style="{StaticResource Section}" />
                  <TextBlock x:Name="WorkspaceHistorySummary" Text="配置变更前自动保存，最多保留 10 个加密版本。" Style="{StaticResource Hint}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="与现有代理共存" Style="{StaticResource Section}" />
                <CheckBox x:Name="ProtectExistingProxy" Content="保护现有代理与虚拟网络" IsChecked="True" Click="SavePreferences" Margin="0,0,0,14" />
                <CheckBox x:Name="SystemProxy" Content="启动时接管 Windows 系统代理" IsChecked="False" Click="SavePreferences" Margin="0,0,0,12" />
                <TextBlock Text="默认使用系统代理。已有代理时，连接前询问是否切换，断开后还原原设置；TUN 与现有虚拟网络冲突时阻止启动。" Style="{StaticResource Hint}" />
                <TextBlock Text="Harbor 的上游网络" Style="{StaticResource Hint}" Margin="0,18,0,8" />
                <ComboBox x:Name="EgressModeInput" SelectedIndex="0">
                  <ComboBoxItem Content="物理网络 · 自动选择" />
                  <ComboBoxItem Content="跟随系统 · 可经过现有 VPN" />
                </ComboBox>
                <TextBlock Text="物理网络模式让 Harbor 独立连接线路，避免被现有 TUN 再次转发。修改后点击下方「保存设置」。" Style="{StaticResource Hint}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="流量接管" Style="{StaticResource Section}" />
                <CheckBox x:Name="TunEnabled" Content="增强模式 · TUN（测试阶段）" Margin="0,0,0,10" />
                <TextBlock Text="通过 Wintun 接管 TCP / UDP。需要管理员权限；路由和 DNS 只应用到临时适配器。" Style="{StaticResource Hint}" />
                <Button Content="以管理员身份重新打开" Click="RestartElevated" HorizontalAlignment="Left" Margin="0,16,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="本地监听" Style="{StaticResource Section}" />
                <TextBlock Text="HTTP / SOCKS5" Style="{StaticResource Hint}" />
                <TextBox x:Name="ListenInput" Margin="0,8,0,16" />
                <TextBlock Text="DNS" Style="{StaticResource Hint}" />
                <TextBox x:Name="DnsListenInput" Margin="0,8,0,16" />
                <CheckBox x:Name="MinimizeToTray" Click="SavePreferences" Content="关闭窗口时收起到系统托盘" IsChecked="False" Margin="0,0,0,16" />
                <Button Content="保存设置" Click="SaveSettings" Style="{StaticResource Primary}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="配置文件" Style="{StaticResource Section}" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="编辑完整配置" Click="EditProfile" Margin="0,0,10,0" />
                  <Button Content="导出配置" Click="ExportProfile" />
                </StackPanel>
                <TextBlock Text="导出配置包含节点密码，保存时请自行选择安全位置。诊断导出不包含密码。" Style="{StaticResource Hint}" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PrivacyPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <DockPanel><Button Content="DNS 服务" Tag="Dns" Click="Navigate" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="隐私保护" Style="{StaticResource Heading}" /></DockPanel>
            <TextBlock Text="限制 Harbor 的出口与记录，按本地规则阻止跟踪域名。" Style="{StaticResource Hint}" Margin="0,0,0,22" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Panel}" Margin="0,0,0,18" VerticalAlignment="Top">
                <StackPanel>
                  <DockPanel>
                    <Button Content="导入拦截规则" DockPanel.Dock="Right" Click="ImportBlockRules" />
                    <TextBlock Text="本地反追踪规则" Style="{StaticResource Section}" />
                  </DockPanel>
                  <TextBlock x:Name="BlockRuleCount" Text="0 个拦截域名 · 0 个例外" Style="{StaticResource Hint}" Margin="0,0,0,16" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="18" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="拦截域名" FontSize="12" Margin="0,0,0,8" />
                      <TextBox x:Name="BlockedDomains" AcceptsReturn="True" Height="238" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="允许的例外" FontSize="12" Margin="0,0,0,8" />
                      <TextBox x:Name="AllowedDomains" AcceptsReturn="True" Height="238" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="每行一个域名，包含其子域名；例外优先。导入支持 hosts、域名列表与 Adblock 域名规则，无法表达的规则会明确提示。" Style="{StaticResource Hint}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="传输限制" Style="{StaticResource Section}" />
                    <CheckBox x:Name="BlockDirect" Margin="0,0,0,13">
                      <TextBlock Text="禁止非回环目标直连" TextWrapping="Wrap" FontSize="12" />
                    </CheckBox>
                    <CheckBox x:Name="RequireEncryption" Margin="0,0,0,13">
                      <TextBlock Text="仅允许加密的代理传输" TextWrapping="Wrap" FontSize="12" />
                    </CheckBox>
                    <TextBlock Text="限制作用于 Harbor 转发的连接。普通 SOCKS5 的 UDP 传输不加密；被禁止的出口会拒绝连接。" Style="{StaticResource Hint}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="本地连接记录" Style="{StaticResource Section}" />
                    <CheckBox x:Name="HideMetadata" Margin="0,0,0,16">
                      <TextBlock Text="隐藏连接目标、来源和出口名称，同时停用事件明细" TextWrapping="Wrap" FontSize="12" />
                    </CheckBox>
                    <TextBlock Text="结束后的记录保留秒数（0 表示不保留）" FontSize="12" Margin="0,0,0,8" />
                    <TextBox x:Name="HistorySeconds" Text="300" Width="140" HorizontalAlignment="Left" />
                    <TextBlock Text="记录只保存在内存。此设置不清除浏览器、系统或其他代理自己的记录。" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal">
              <Button Content="保存隐私设置" Style="{StaticResource Primary}" Click="SavePrivacy" Margin="0,0,10,0" />
              <Button Content="清空已结束记录" Click="ClearHistory" />
            </StackPanel>
            <TextBlock Text="更改拦截域名或传输限制前需先停止 Harbor，避免已有连接保留旧规则。加密 DNS 在 DNS 页面设置。" Style="{StaticResource Hint}" Margin="0,14,0,16" />
            <Border Background="#EAF0F5" CornerRadius="6" Padding="17">
              <TextBlock Text="保护边界：网络代理不消除浏览器指纹、账号关联或端点恶意软件。" Style="{StaticResource Hint}" />
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="NetworkPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <DockPanel><Button Content="运行诊断" Tag="Diagnostics" Click="Navigate" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="网络管理" Style="{StaticResource Heading}" /></DockPanel>
            <TextBlock Text="只读查看 Windows 网络与共存状态。" Style="{StaticResource Hint}" Margin="0,0,0,22" />
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,18">
            <DockPanel>
              <Button Content="刷新状态" DockPanel.Dock="Right" Click="RefreshNetwork" />
              <StackPanel>
                <TextBlock x:Name="NetworkSummary" Text="等待读取网络状态。" FontWeight="SemiBold" />
                <TextBlock x:Name="NetworkProtection" Text="此页面不修改网卡、DNS 或路由。" Style="{StaticResource Hint}" Margin="0,9,20,0" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
            <DataGrid x:Name="AdapterGrid" RowHeight="65">
              <DataGrid.Columns>
                <DataGridTextColumn Header="网络接口" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="82" />
                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110" />
                <DataGridTextColumn Header="链路速率" Binding="{Binding Speed}" Width="105" />
                <DataGridTextColumn Header="本地地址" Binding="{Binding Addresses}" Width="*" />
                <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="180" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="30,0">
        <DockPanel>
          <TextBlock x:Name="FooterState" Text="本地工作空间" FontSize="10" Foreground="#8A9590" VerticalAlignment="Center" />
          <TextBlock x:Name="FooterTraffic" DockPanel.Dock="Right" Text="无网络接管" FontSize="10" Foreground="#8A9590" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
