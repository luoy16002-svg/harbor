<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Harbor" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Harbor.MainWindow" Title="Harbor" Width="1280" Height="840" MinWidth="960" MinHeight="660" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" Foreground="{StaticResource Ink}" Background="#F5F7F5" Loaded="WindowLoaded" Closing="WindowClosing" WindowStyle="None" ResizeMode="CanResize" SizeChanged="WindowSizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="7" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid Background="#F5F7F5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="184" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#EEF1EF" BorderBrush="#E0E7E2" BorderThickness="0">
      <DockPanel Margin="12,24,12,18">
        <StackPanel DockPanel.Dock="Top" Margin="12,0,0,34">
          <StackPanel Orientation="Horizontal">
            <Image Source="Assets/harbor.png" Width="34" Height="34" Margin="-2,-2,8,-2" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Harbor 标志"/>
            <TextBlock Text="Harbor" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
          </StackPanel>
          <TextBlock Text="网络与隐私" FontSize="11" Foreground="#65776D" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="#DEE5E0" Margin="10,0,10,16" />
          <StackPanel Orientation="Horizontal" Margin="12,0,0,7">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#94A29A" Margin="0,0,7,0" />
            <TextBlock x:Name="SidebarStatus" Text="引擎未启动" FontSize="11" Foreground="#65776D" />
          </StackPanel>
          <TextBlock x:Name="VersionLabel" Margin="12,0,0,0" FontSize="10" Foreground="#65776D" />
        </StackPanel>
        <StackPanel>
          <Button x:Name="NavOverview" Style="{StaticResource Nav}" Tag="Overview" Click="Navigate" Background="#DFE9E4">
            <StackPanel Orientation="Horizontal">
              <Path Data="M2,2 L8,2 L8,8 L2,8 Z M12,2 L18,2 L18,8 L12,8 Z M2,12 L8,12 L8,18 L2,18 Z M12,12 L18,12 L18,18 L12,18 Z" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,14,0" />
              <TextBlock Text="总览" FontFamily="Microsoft YaHei UI" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="NavConnections" Style="{StaticResource Nav}" Tag="Connections" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M2,6 L18,6 M14,2 L18,6 L14,10 M18,14 L2,14 M6,10 L2,14 L6,18" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,14,0" />
              <TextBlock Text="连接" FontFamily="Microsoft YaHei UI" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="NavNodes" Style="{StaticResource Nav}" Tag="Nodes" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M10,2 A3,3 0 1 0 10,8 A3,3 0 1 0 10,2 M4,13 A3,3 0 1 0 4,19 A3,3 0 1 0 4,13 M16,13 A3,3 0 1 0 16,19 A3,3 0 1 0 16,13 M8,8 L5,13 M12,8 L15,13" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,14,0" />
              <TextBlock Text="线路" FontFamily="Microsoft YaHei UI" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSubscriptions" Visibility="Collapsed" Style="{StaticResource Nav}" Tag="Subscriptions" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M4,2 L14,2 L18,6 L18,18 L4,18 Z M14,2 L14,6 L18,6 M8,9 L14,9 M8,13 L14,13" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" StrokeLineJoin="Round" Margin="0,0,14,0" />
              <TextBlock Text="订阅" FontFamily="Microsoft YaHei UI" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="NavPools" Style="{StaticResource Nav}" Tag="Pools" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M2,3 L18,3 L18,7 L2,7 Z M2,11 L18,11 L18,15 L2,15 Z M6,7 L6,11 M14,7 L14,11" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" StrokeLineJoin="Round" Margin="0,0,14,0" />
              <TextBlock Text="线路池" />
            </StackPanel>
          </Button>
          <Button x:Name="NavRouting" Style="{StaticResource Nav}" Tag="Routing" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M4,2 L4,17 M4,7 L11,7 L16,2 M11,7 L16,12 M12,2 L16,2 L16,6 M12,12 L16,12 L16,8" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,14,0" />
              <TextBlock Text="分流" FontFamily="Microsoft YaHei UI" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="NavDns" Visibility="Collapsed" Style="{StaticResource Nav}" Tag="Dns" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M10,1 A9,9 0 1 0 10,19 A9,9 0 1 0 10,1 M1,10 L19,10 M10,1 C4,6 4,14 10,19 M10,1 C16,6 16,14 10,19" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,14,0" />
              <TextBlock Text="DNS" FontFamily="Microsoft YaHei UI" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="NavPrivacy" Style="{StaticResource Nav}" Tag="Privacy" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M10,1 L18,4 L17,12 Q15,17 10,20 Q5,17 3,12 L2,4 Z M6,10 L9,13 L14,7" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" Margin="0,0,14,0" />
              <TextBlock Text="隐私保护" />
            </StackPanel>
          </Button>
          <Button x:Name="NavNetwork" Style="{StaticResource Nav}" Tag="Network" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M2,3 L18,3 L18,14 L2,14 Z M6,18 L14,18 M10,14 L10,18" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" Margin="0,0,14,0" />
              <TextBlock Text="网络管理" />
            </StackPanel>
          </Button>
          <Button x:Name="NavDiagnostics" Visibility="Collapsed" Style="{StaticResource Nav}" Tag="Diagnostics" Click="Navigate">
            <StackPanel Orientation="Horizontal">
              <Path Data="M1,11 L5,11 L8,3 L12,17 L15,8 L18,8" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,14,0" />
              <TextBlock Text="诊断" FontFamily="Microsoft YaHei UI" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSettings" Style="{StaticResource Nav}" Tag="Settings" Click="Navigate" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal">
              <Path Data="M3,4 L17,4 M3,10 L17,10 M3,16 L17,16 M7,1 L7,7 M13,7 L13,13 M7,13 L7,19" Width="17" Height="17" Stretch="Uniform" Stroke="#65776D" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,14,0" />
              <TextBlock Text="设置" FontFamily="Microsoft YaHei UI" FontSize="13" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="54" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <Border Background="#F5F7F5" Padding="24,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="Breadcrumb" Text="总览" FontSize="13" Foreground="#566B5E" VerticalAlignment="Center" />
            <Border Background="#E7EEE9" CornerRadius="4" Padding="9,4" Margin="14,0,0,0">
              <TextBlock x:Name="ModeLabel" Text="系统代理" Foreground="#3D6A5B" FontSize="11" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock x:Name="RunState" Text="已停止" VerticalAlignment="Center" FontSize="11" Foreground="#637469" Margin="0,0,14,0" />
            <Button x:Name="ConnectButton" Content="连接" Style="{StaticResource Primary}" Padding="15,7" Click="ToggleEngine" Margin="0,0,18,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化">
              <Path Data="M0,5 L11,5" Stroke="#5B6F60" StrokeThickness="1" />
            </Button>
            <Button Style="{StaticResource CaptionButton}" Click="MaximizeWindow" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原">
              <Path Data="M1,1 L11,1 L11,11 L1,11 Z" Stroke="#5B6F60" StrokeThickness="1" />
            </Button>
            <Button Style="{StaticResource CaptionButton}" Click="CloseWindow" ToolTip="关闭" AutomationProperties.Name="关闭窗口">
              <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="#5B6F60" StrokeThickness="1.2" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" Background="#FFF3DC" BorderBrush="#EDD8B1" BorderThickness="0,0,0,1" Padding="30,12">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="关闭" Padding="8,2" Background="Transparent" BorderThickness="0" Click="DismissNotice" />
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#806132" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <Grid Grid.Row="2" Margin="24,18,20,14">
        <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="总览" Style="{StaticResource Heading}" />
            <TextBlock x:Name="OverviewSubtitle" Text="选择线路、查看流量，以及管理应用的网络路径。" Style="{StaticResource Hint}" Margin="0,0,0,22" />
            <Border Style="{StaticResource Panel}" Padding="22,18" Margin="0,0,0,18" Background="#EDF3EE">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="HomeAdd" Content="添加线路" Click="AddLines" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="HomeCheckResult" Text="尚未验证" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,14,0" FontSize="11" Foreground="{StaticResource Muted}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="HomeTitle" Text="从第一条线路开始" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="HomeDescription" Style="{StaticResource Hint}" Margin="0,8,0,16"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="默认出口" Style="{StaticResource Hint}" Margin="0,0,0,7"/><ComboBox x:Name="HomePolicy" SelectionChanged="HomePolicyChanged"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="连接方式" Style="{StaticResource Hint}" Margin="0,0,0,7"/><ComboBox x:Name="HomeMode" SelectionChanged="HomeModeChanged"><sys:String>系统代理 · 常用</sys:String><sys:String>应用代理 · 手动指定</sys:String><sys:String>增强模式 · TUN 实验</sys:String></ComboBox></StackPanel>
                  <Button x:Name="HomeVerify" Grid.Column="3" Content="验证线路" Click="VerifySelected" VerticalAlignment="Bottom" Margin="12,0,0,0" ToolTip="通过此线路完成到 www.example.com 的 HTTPS 请求；不修改系统网络设置。"/>
                </Grid>
                <TextBlock x:Name="ModeDescription" Style="{StaticResource Hint}" Margin="0,11,0,0"/>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="分流模式" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Hint}"/>
                  <ComboBox x:Name="HomeRoutingMode" Grid.Column="1" SelectionChanged="RoutingModeChanged"/>
                  <TextBlock x:Name="HomeRoutingDescription" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Hint}"/>
                </Grid>
                <DockPanel x:Name="HeroStatusRow" Margin="0,16,0,0"><TextBlock x:Name="OnboardingSteps" FontSize="11" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"/></DockPanel>
              </StackPanel>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition x:Name="OverviewGap" Width="18" />
                <ColumnDefinition x:Name="OverviewRailWidth" Width="248" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <Border Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,18">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="实时流量" FontWeight="SemiBold" />
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="下载" FontSize="11" Foreground="#397AAA" Margin="0,0,15,0" />
                        <TextBlock Text="上传" FontSize="11" Foreground="#579B85" />
                      </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,20,0,22">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock x:Name="DownloadRate" Text="0 B/s" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="下载速率" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock x:Name="UploadRate" Text="0 B/s" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="上传速率" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="ActiveCount" Text="0" FontSize="27" FontWeight="SemiBold" />
                          <TextBlock x:Name="TotalCount" Text="/ 共 0 条" Style="{StaticResource Hint}" Margin="10,0,0,3" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="活跃连接" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                      </StackPanel>
                    </Grid>
                    <local:TrafficChart x:Name="Chart" Height="180" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="0">
                  <StackPanel>
                    <DockPanel Margin="20,17">
                      <TextBlock Text="最近连接" FontWeight="SemiBold" />
                      <Button Content="查看全部" DockPanel.Dock="Right" Tag="Connections" Click="Navigate" Padding="0" BorderThickness="0" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" />
                    </DockPanel>
                    <Grid>
                      <DataGrid x:Name="RecentGrid" Height="214">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="目标" Binding="{Binding Destination}" Width="*" />
                          <DataGridTextColumn Header="出口" Binding="{Binding Outbound}" Width="115" />
                          <DataGridTextColumn Header="流量" Binding="{Binding Traffic}" Width="88" />
                          <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="72" />
                          <DataGridTemplateColumn Header="原因" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Failure}" ToolTip="{Binding Error}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                      </DataGrid>
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,36,20,0" IsHitTestVisible="False">
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasItems, ElementName=RecentGrid}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <TextBlock Text="尚无连接" TextAlignment="Center" FontSize="15" Foreground="#53695C" />
                        <TextBlock Text="启动后显示实际流量与规则结果。" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,9,0,0" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="OverviewRail" Grid.Column="2">
                <Border Style="{StaticResource Panel}" Padding="17" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="当前默认路径" Style="{StaticResource Section}" />
                    <TextBlock Text="01  本地入口" Foreground="#65786B" FontSize="11" />
                    <TextBlock x:Name="ProxyAddress" Text="127.0.0.1:7897" FontFamily="Consolas" FontSize="12" Margin="0,7,0,14" />
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14" />
                    <TextBlock Text="02  分流出口" Foreground="#65786B" FontSize="11" />
                    <TextBlock x:Name="PolicySummary" Text="DIRECT" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,9" />
                    <TextBlock x:Name="PolicyDetail" Text="未命中规则的连接使用直连。" Style="{StaticResource Hint}" />
                    <Button Content="预演规则变化" Tag="Routing" Click="Navigate" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="17" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="隐私设置" Style="{StaticResource Section}" />
                    <TextBlock x:Name="PrivacyOverview" Text="按实际配置显示保护状态。" Style="{StaticResource Hint}" />
                    <Button Content="管理隐私" Tag="Privacy" Click="Navigate" Margin="0,14,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="17">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                      <TextBlock Text="网络共存" FontWeight="SemiBold" />
                      <TextBlock x:Name="RecoveryBadge" Text="本地模式" DockPanel.Dock="Right" Foreground="#448A78" FontSize="10" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock x:Name="RecoveryText" Text="未接管系统代理。" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="GuardianText" Text="共存保护默认开启。" Style="{StaticResource Hint}" Margin="0,10,0,14" />
                    <Button Content="检查网络状态" Tag="Network" Click="Navigate" Padding="10,7" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="ConnectionsPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="连接" Style="{StaticResource Heading}" />
            <TextBlock Text="查看目标、命中规则和实际出口。连接不因规则更新而改道。" Style="{StaticResource Hint}" Margin="0,0,0,22" />
          </StackPanel>
          <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="关闭选中连接" Click="CloseSelectedFlow" IsEnabled="{Binding SelectedItem, ElementName=FlowGrid, Converter={StaticResource HasSelection}}" />
            <TextBox x:Name="FlowSearch" Width="300" HorizontalAlignment="Left" ToolTip="按目标、策略或出口筛选" TextChanged="FilterFlows" />
          </DockPanel>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
            <Grid>
              <DataGrid x:Name="FlowGrid" SelectionChanged="FlowSelected">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="目标" Binding="{Binding Destination}" Width="*" />
                  <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="85" />
                  <DataGridTextColumn Header="出口" Binding="{Binding Outbound}" Width="130" />
                  <DataGridTextColumn Header="流量" Binding="{Binding Traffic}" Width="105" />
                  <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,42,20,0" IsHitTestVisible="False">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=FlowGrid}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="这里会显示经过 Harbor 的连接" FontSize="14" Foreground="#53616C" TextAlignment="Center" />
                <TextBlock Text="启动连接后，可按目标、出口或策略筛选。" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="3" Background="#ECF1ED" Padding="16" Margin="0,14,0,0" CornerRadius="5">
            <TextBlock x:Name="FlowDetail" Text="选择一条连接查看分流依据。" Style="{StaticResource Hint}" />
          </Border>
        </Grid>
        <Grid x:Name="PoolsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,20">
            <DockPanel><Button Content="创建线路池" Click="AddPool" Style="{StaticResource Primary}" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="自动线路池" Style="{StaticResource Heading}"/></DockPanel>
            <TextBlock x:Name="PoolCount" Style="{StaticResource Hint}"/>
          </StackPanel>
          <Border x:Name="PoolEmpty" Grid.Row="1" Style="{StaticResource Panel}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="490">
              <TextBlock Text="主线出故障，备线接着走" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock Text="选几条日常使用的线路。Harbor 定期检查实际 HTTPS 连通性，在建连失败时继续尝试池内备线，并记录恢复经过。" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,18,0,22"/>
              <Button Content="选择主线和备线" Click="AddPool" Style="{StaticResource Primary}" HorizontalAlignment="Center"/>
              <TextBlock Text="可作为默认出口，或在分流页面分配给应用与网站。" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,16,0,0"/>
